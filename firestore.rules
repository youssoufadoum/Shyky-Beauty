rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Helpers
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isAdmin() {
      return isSignedIn() && 
             (request.auth.token.email == 'y.adamabakar81@gmail.com' || 
              request.auth.token.email == 'shykybeauty@yahoo.com') &&
             request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128;
    }

    // Test connection
    match /test/connection {
      allow read: if true;
    }

    // Products
    match /products/{productId} {
      function isValidProduct(data) {
        return data.name is string && data.name.size() > 0
            && data.price is number;
      }

      allow get, list: if true;
      
      allow create, update, delete: if isAdmin();
    }

    // Orders
    match /orders/{orderId} {
      function isValidOrder(data) {
        return data.customerName is string && data.customerName.size() > 0
            && data.customerContact is string && data.customerContact.size() > 0
            && data.items is list && data.items.size() > 0
            && data.totalAmount is number
            && data.status is string
            && data.orderType is string
            && (data.createdAt == request.time || data.createdAt is timestamp);
      }

      allow create: if true; // Allow anyone to place an order
      
      // Admin only
      allow list: if isAdmin();
      allow get: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }
  }
}
